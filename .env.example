# Server
PORT=8787
# Public origin of the app (used in emails and OAuth redirects)
APP_ORIGIN=http://localhost:5173
# SQLite file location
DATABASE_PATH=./data/the-news.db
# Re-stamp the bundled demo stories to "today" on boot (turn off once a real ingest pipeline feeds /api/admin/stories)
SEED_DEMO=1
# Bearer token for POST /api/admin/stories (story ingest). Leave empty to disable the endpoint.
ADMIN_TOKEN=

# Email (verification codes, password reset). Without SMTP_URL, emails are printed to the server log.
SMTP_URL=
MAIL_FROM="The News <hello@thenews.app>"

# Sign in with Google (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key, with \n for newlines
APPLE_PRIVATE_KEY=

# Web push for the daily story notification (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@thenews.app
