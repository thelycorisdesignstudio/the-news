# Server
PORT=8787
# Public origin of the app (used in emails and OAuth redirects)
APP_ORIGIN=http://localhost:5173
# SQLite file location
DATABASE_PATH=./data/the-news.db
# Bundled demo stories, re-stamped to "today" on boot. Off by default while live news is on.
# Set SEED_DEMO=1 LIVE_NEWS=0 for a fixed demo without network access.
SEED_DEMO=
# Dummy log in / sign up for now: any email and password signs in. 0 restores real accounts.
DUMMY_AUTH=1
# Demo helpers: codes and reset links shown on screen, Apple/Google sign in as a demo reader. 0 for launch.
DEMO_AUTH=1
# Bearer token for the admin API (story ingest, /api/admin/sources, /api/admin/ingest). Empty disables it.
ADMIN_TOKEN=

# Live news: RSS feeds polled every few minutes, written up by Claude. 0 turns it off.
LIVE_NEWS=1
# Without a key, cards are written by the rule-based extractive writer.
ANTHROPIC_API_KEY=
NEWS_MODEL=claude-opus-5
# Most articles written up per one-minute cycle
INGEST_MAX_PER_CYCLE=40
# Extra feeds: "Name|https://example.com/feed,https://other.example/rss"
NEWS_FEEDS=
# Full article text through Jina Reader (agent-reach's web channel). READER=0 disables it.
READER=1
JINA_API_KEY=
# Exa news search (agent-reach's search channel): free MCP endpoint by default; a key uses the Exa API. EXA=0 turns it off.
EXA=1
EXA_API_KEY=
# Optional: path to the agent-reach CLI (scripts/setup-agent-reach.sh installs it); its `doctor --json` report joins /api/admin/sources
AGENT_REACH_BIN=

# Email (verification codes, password reset). Without SMTP_URL, emails are printed to the server log.
SMTP_URL=
MAIL_FROM="The News <hello@thenews.app>"

# Sign in with Google (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key, with \n for newlines
APPLE_PRIVATE_KEY=

# Web push for the daily story notification (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@thenews.app
